# Copie este arquivo para .streamlit/secrets.toml (que NÃO vai para o git)
# e cole o mesmo conteúdo em Settings > Secrets no Streamlit Community Cloud.

[login]
# Conta de emergência, que não fica na planilha de usuários: serve para o primeiro acesso, para aprovar
# os primeiros cadastros. Use uma senha longa (mínimo recomendado: 16 caracteres).
administrador = ""
senha_administrador = ""
# Origem dos usuários: "codigo" (padrão, arquivo usuarios_codigo.py) ou "planilha" (cadastro com aprovação).
# origem_usuarios = "codigo"

[onedrive]
# Sem esta seção completa, o app usa o arquivo local "PROJETOS - Teste 1.xlsx".
tenant_id = "84a9248e-396f-44df-84a9-4379e11007ab"
client_id = "187765ef-00cb-4b00-aa8e-bd3ea26a5b25"
# Valor (Value) do client secret criado em Certificates & secrets. Vence em: __/__/____
client_secret = ""
# Gerados por: python descobrir_ids.py "<link do arquivo no SharePoint>"
drive_id = ""
item_id = ""
# Planilha interna (usuários, rascunhos, pareceres), em arquivo à parte e com acesso restrito à DPLAN.
# Sem este campo, os cadastros ficam num arquivo local do servidor (apagado a cada reinício no Streamlit Cloud).
item_id_interno = ""
